# Copy to .env for local development. In Northflank these are set as
# service environment variables / secret groups instead.

# Telegram bot token from @BotFather
BOT_TOKEN=

# SQLAlchemy URL for the production MySQL database.
# Managed providers (Aiven, DigitalOcean, TiDB, ...) usually hand out
# "mysql://...?ssl-mode=REQUIRED"; paste it as-is. The driver part
# (+asyncmy / +pymysql) and ssl-mode are handled by core/database_url.py.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE?ssl-mode=REQUIRED

# Comma-separated Telegram user ids that are bootstrapped as owners
ADMIN_IDS=123456789

# Optional: set to "false" if migrations are run by a separate job
RUN_MIGRATIONS=true

# Only for running the test suite locally; never point at production
# TEST_DATABASE_URL=mysql+asyncmy://USER:PASSWORD@HOST:3306/DATABASE_test

# Optional. Set by PaaS "web service" plans (Koyeb, Render, ...) that require
# an open HTTP port. When present the bot serves GET / and /health -> 200
# on it; leave unset when running as a worker or locally.
# PORT=8000
